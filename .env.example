# ❗ .cn 与 .com 平台账号不互通，API Key 不共用。
# 切换 Base URL 时必须更换为对应平台的 Key。
AGNES_API_KEY=your_agnes_api_key_here
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
# 国际站: https://apihub.agnes-ai.com/v1

# 图片模型（三选一）：agnes-image-2.5-flash（默认，免费）/ agnes-image-2.1-flash / agnes-image-2.0-flash
# 三者均支持 1K/2K/3K/4K 档位 + ratio；2.0 兼容历史精确尺寸（如 1024x768）
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_IMAGE_MODEL_V2=agnes-image-2.5-flash

# 视频模型（三选一）：
#   agnes-video-2.5-flash  限时免费；仅 720P；images<=5；audios<=3；不支持参考视频
#   agnes-video-2.5        收费：720P $0.025/s、1080P/1K $0.040/s、2K $0.055/s；输入视频秒数计入计费
#   agnes-video-v2.0       旧版模型，接口兼容 2.5
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

# 输出目录。相对路径基于 MCP 服务器进程的 CWD 解析，
# 建议在 MCP 客户端配置中使用绝对路径。
AGNES_OUTPUT_DIR=./outputs
